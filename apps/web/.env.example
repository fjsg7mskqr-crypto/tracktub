# Supabase — copy to .env.local and fill in (values from Project Settings → API).
# .env.local is gitignored. NEVER commit real keys; never paste service_role in chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (NEVER NEXT_PUBLIC_). Two uses: the RLS test suite provisions and
# tears down test data, and the public report (/proof/[token]) signs its photo
# links with it (src/lib/supabase/service.ts, issue #44). Set it in Vercel for
# Production AND Preview, then redeploy. Without it, shared reports still render
# but show "Photo unavailable" where photos belong.
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting (issue #42) — OPTIONAL. Without these two vars, rate limiting is
# a no-op (every request allowed), so the app runs fine locally without them.
# To activate: create an Upstash Redis (https://upstash.com), then set both in
# Vercel for Preview + Production. Server-only; never NEXT_PUBLIC_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
