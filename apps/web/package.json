{
  "name": "tracktub-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "vercel-build": "next build && node scripts/link-next-at-monorepo-root.mjs",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/rls.test.ts tests/visit.rls.test.ts tests/photos-private.rls.test.ts",
    "knip": "knip --include files,dependencies,devDependencies,unlisted,unresolved,binaries",
    "promo:status": "bash ../../scripts/promo-status.sh"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.78.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "botid": "1.5.13",
    "gray-matter": "^4.0.3",
    "next": "16.4.6",
    "posthog-js": "^1.450.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@sentry/bundler-plugins": {
      "glob": "^14.0.2"
    },
    "glob": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "knip": "5.88.1",
    "postcss": "^8.5.10",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
